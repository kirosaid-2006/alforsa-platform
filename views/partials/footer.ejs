<style>
    @media (max-width: 768px) {
        .mobile-footer { padding: 2rem 0 0 !important; }
        .mobile-footer .footer-disclaimer { padding: 0.85rem 1rem !important; font-size: 0.78rem !important; margin-bottom: 1.75rem !important; border-radius: 12px !important; line-height: 1.6 !important; }
        .mobile-footer .footer-disclaimer .disclaimer-title { font-size: 0.88rem !important; }
        .mobile-footer .footer-grid { grid-template-columns: repeat(2, 1fr) !important; gap: 1.5rem !important; margin-bottom: 2rem !important; }
        .mobile-footer .footer-grid h4 { font-size: 0.95rem !important; margin-bottom: 0.85rem !important; }
        .mobile-footer .footer-grid a { font-size: 0.82rem !important; }
        .mobile-footer .footer-grid ul { gap: 0.5rem !important; }
        .mobile-footer .footer-brand-name { font-size: 1.3rem !important; }
        .mobile-footer .footer-brand-desc { font-size: 0.82rem !important; margin-bottom: 1rem !important; }
        .mobile-footer .footer-cta { font-size: 0.8rem !important; padding: 0.45rem 0.9rem !important; }
        .mobile-footer .footer-bottom { padding: 0.85rem 0 !important; font-size: 0.78rem !important; }
        .mobile-footer .footer-bottom .container { flex-direction: column !important; text-align: center !important; gap: 0.35rem !important; }
    }
</style>
<footer class="mobile-footer" style="background: #0a2c36; color: #f8fafc; padding: 3.5rem 0 0; margin-top: auto; border-top: 3px solid #ea580c;">
    <div class="container">
        
        <!-- Disclaimer Banner -->
        <div class="footer-disclaimer" style="background: rgba(234, 88, 12, 0.12); border: 1px solid rgba(234, 88, 12, 0.3); color: #fdba74; padding: 1.25rem 1.5rem; border-radius: 16px; margin-bottom: 3rem; line-height: 1.7; font-size: 0.9rem;">
            <div class="disclaimer-title" style="font-weight: 800; font-size: 1.05rem; margin-bottom: 0.5rem; color: #ffedd5;">
                إخلاء مسؤولية وتنبيه هام:
            </div>
            كافة بيانات الوظائف المنشورة هي مسؤولية الشركة أو الجهة المعلنة، والمنصة مجانية بالكامل ولا تتقاضى أي مبالغ مالية من الباحثين عن عمل. يرجى توخي الحذر وتجنب دفع أي رسوم مقابل التعيين.
            <br>
            الكنيسة لا تتدخل بأي شكل في إجراءات التوظيف أو شروط العمل أو تحديد المرتبات. دور منصة "فرصة" يقتصر على كونه حلقة وصل مجانية لعرض الوظائف وتسهيل تواصل الباحثين مع الشركات.
        </div>
        
        <!-- Footer Responsive Grid -->
        <div class="footer-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 2.5rem; margin-bottom: 3rem;">
            
            <!-- Col 1: Brand Info -->
            <div>
                <div class="footer-brand-name" style="font-size: 1.7rem; font-weight: 900; color: white; display: flex; align-items: center; gap: 8px; margin-bottom: 1rem;">
                    <span style="font-size: 1.5rem;">🎯</span>
                    <span style="color: white;">فرصة</span>
                </div>
                <p class="footer-brand-desc" style="color: #94a3b8; line-height: 1.8; font-size: 0.95rem; margin-bottom: 1.5rem;">
                    المنصة الأولى الموثوقة لتوصيل الباحثين عن عمل بالشركات والمصانع في مصر، بطريقة مباشرة وسريعة وبدون أي وسطاء.
                </p>
                <a href="/jobs/quick-submit" class="footer-cta" style="background: #ea580c; color: white; padding: 0.6rem 1.2rem; border-radius: 8px; font-size: 0.9rem; font-weight: 800; text-decoration: none; display: inline-block;">أعلن عن وظيفة مجاناً</a>
            </div>
            
            <!-- Col 2: For Job Seekers -->
            <div>
                <h4 style="color: white; font-size: 1.1rem; font-weight: 800; margin-bottom: 1.25rem; border-bottom: 2px solid #ea580c; padding-bottom: 0.5rem; display: inline-block;">للباحثين عن عمل</h4>
                <ul style="display: flex; flex-direction: column; gap: 0.75rem; padding: 0; margin: 0; list-style: none;">
                    <li><a href="/jobs" style="color: #cbd5e1; text-decoration: none; font-size: 0.95rem; transition: color 0.2s;">تصفح كل الوظائف</a></li>
                    <li><a href="/auth/register" style="color: #cbd5e1; text-decoration: none; font-size: 0.95rem; transition: color 0.2s;">إنشاء حساب جديد</a></li>
                    <li><a href="/user/dashboard" style="color: #cbd5e1; text-decoration: none; font-size: 0.95rem; transition: color 0.2s;">لوحة متابعة الطلبات</a></li>
                </ul>
            </div>

            <!-- Col 3: For Employers -->
            <div>
                <h4 style="color: white; font-size: 1.1rem; font-weight: 800; margin-bottom: 1.25rem; border-bottom: 2px solid #ea580c; padding-bottom: 0.5rem; display: inline-block;">لأصحاب الأعمال</h4>
                <ul style="display: flex; flex-direction: column; gap: 0.75rem; padding: 0; margin: 0; list-style: none;">
                    <li><a href="/jobs/quick-submit" style="color: #cbd5e1; text-decoration: none; font-size: 0.95rem; transition: color 0.2s;">أعلن عن وظيفة مجاناً</a></li>
                    <li><a href="/about" style="color: #cbd5e1; text-decoration: none; font-size: 0.95rem; transition: color 0.2s;">عن منصة فرصة</a></li>
                </ul>
            </div>
            
            <!-- Col 4: Help & Support -->
            <div>
                <h4 style="color: white; font-size: 1.1rem; font-weight: 800; margin-bottom: 1.25rem; border-bottom: 2px solid #ea580c; padding-bottom: 0.5rem; display: inline-block;">الدعم والمساعدة</h4>
                <ul style="display: flex; flex-direction: column; gap: 0.75rem; padding: 0; margin: 0; list-style: none;">
                    <li><a href="/faq" style="color: #cbd5e1; text-decoration: none; font-size: 0.95rem; transition: color 0.2s;">الأسئلة الشائعة</a></li>
                    <li><a href="/about" style="color: #cbd5e1; text-decoration: none; font-size: 0.95rem; transition: color 0.2s;">سياسة الخصوصية</a></li>
                </ul>
            </div>

        </div>
    </div>
    
    <!-- Footer Bottom Bar -->
    <div class="footer-bottom" style="background: #061d24; border-top: 1px solid rgba(255,255,255,0.08); padding: 1.25rem 0; text-align: center; color: #64748b; font-size: 0.9rem;">
        <div class="container" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
            <div>
                &copy; <%= new Date().getFullYear() %> منصة فرصة. جميع الحقوق محفوظة.
            </div>
            <div style="color: #94a3b8; font-weight: 600;">
                منصة توظيف مصرية متكاملة
            </div>
        </div>
    </div>
</footer>
