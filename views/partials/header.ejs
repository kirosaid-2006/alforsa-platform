<header style="background: #0e3a47; border-bottom: 2px solid #061d24; position: sticky; top: 0; z-index: 1000; box-shadow: 0 4px 20px rgba(0,0,0,0.15);">
    <!-- Top Decorative Accent Line -->
    <div style="height: 3px; background: linear-gradient(90deg, #ea580c 0%, #f97316 50%, #0284c7 100%);"></div>

    <div class="container navbar" style="min-height: 72px; height: auto; padding-top: 0.5rem; padding-bottom: 0.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
        <!-- Logo -->
        <a href="/" class="nav-brand" style="display: flex; align-items: center; gap: 8px; font-size: 1.9rem; font-weight: 900; text-decoration: none;">
            <span style="font-size: 2rem;">🎯</span>
            <span style="color: #ffffff; font-weight: 900; font-family: 'Cairo', sans-serif; text-shadow: 0 2px 4px rgba(0,0,0,0.2);">فرصة</span>
        </a>
        
        <!-- Navigation Links -->
        <nav class="nav-links" style="display: flex; align-items: center; gap: 1.25rem; flex-wrap: wrap;">
            <a href="/" style="color: rgba(255,255,255,0.9); font-weight: 700; transition: color 0.2s;" class="<%= typeof path !== 'undefined' && path === '/' ? 'active' : '' %>">الرئيسية</a>
            <a href="/jobs" style="color: rgba(255,255,255,0.9); font-weight: 700; transition: color 0.2s;" class="<%= typeof path !== 'undefined' && path === '/jobs' ? 'active' : '' %>">تصفح الوظائف</a>
            <a href="/jobs/quick-submit" style="color: #ffffff !important; font-weight: 800; display: inline-flex; align-items: center; gap: 6px; background: #ea580c; padding: 0.45rem 1.1rem; border-radius: 9999px; text-decoration: none; box-shadow: 0 4px 12px rgba(234, 88, 12, 0.3); transition: transform 0.2s;">
                أعلن عن وظيفة مجاناً
            </a>
            <a href="/about" style="color: rgba(255,255,255,0.9); font-weight: 700; transition: color 0.2s;">عن المنصة</a>
        </nav>

        <!-- Auth Section -->
        <div class="nav-auth" style="display: flex; align-items: center; gap: 1rem; flex-wrap: wrap;">
            <% if (locals.user) { %>
                <span style="color: rgba(255,255,255,0.9); font-weight: 600;">
                    مرحباً، <%= user.full_name.split(' ')[0] %>
                </span>
                
                <% if (user.Role && user.Role.name === 'admin' || user.Role && user.Role.name === 'super_admin') { %>
                    <a href="/admin" class="btn" style="background: rgba(255,255,255,0.15); color: white !important; border: 1px solid rgba(255,255,255,0.3); padding: 0.4rem 1rem;">لوحة الإدارة</a>
                <% } else if (user.Role && user.Role.name === 'employer') { %>
                    <a href="/employer" class="btn" style="background: rgba(255,255,255,0.15); color: white !important; border: 1px solid rgba(255,255,255,0.3); padding: 0.4rem 1rem;">لوحة الشركة</a>
                <% } else { %>
                    <a href="/user/dashboard" class="btn" style="background: rgba(255,255,255,0.15); color: white !important; border: 1px solid rgba(255,255,255,0.3); padding: 0.4rem 1rem;">حسابي</a>
                <% } %>
                
                <a href="/auth/logout" style="color: #fca5a5; font-weight: 700; text-decoration: none; font-size: 0.9rem;">تسجيل الخروج</a>
            <% } else { %>
                <a href="/auth/login" style="color: rgba(255,255,255,0.9); font-weight: 700; text-decoration: none;">دخول</a>
                <a href="/auth/register" class="btn" style="background: #ffffff; color: #0e3a47 !important; font-weight: 800; padding: 0.45rem 1.2rem; border-radius: 8px;">حساب جديد</a>
            <% } %>
        </div>
    </div>
</header>
