            'manual-labor': '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 18h2l1-5h14l1 5h2"/><path d="M6 13V8a2 2 0 0 1 2-2h8a2 2 0 0 1 2 2v5"/><path d="M10 6V4a2 2 0 0 1 4 0v2"/><circle cx="12" cy="18" r="2"/></svg>',
            'drivers': '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M5 17h14"/><path d="M3 11l2-6h14l2 6"/><rect x="3" y="11" width="18" height="6" rx="1"/><circle cx="7" cy="17" r="2"/><circle cx="17" cy="17" r="2"/></svg>',
            'technicians-craftsmen': '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z"/></svg>',
            'security': '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/></svg>',
            'sales': '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M6 2 3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/><path d="M3 6h18"/><path d="M16 10a4 4 0 0 1-8 0"/></svg>',
            'customer-service': '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3z"/><path d="M3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/></svg>',
            'it-software': '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2"/><path d="M8 21h8"/><path d="M12 17v4"/><path d="m7 8 3 3-3 3"/><path d="M13 14h4"/></svg>',
            'engineering': '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M2 20h20"/><path d="M5 20V8l7-5 7 5v12"/><path d="M10 20v-6h4v6"/><path d="M9 12h6"/></svg>',
            'medical-pharma': '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><path d="M12 10v6"/><path d="M9 13h6"/><rect x="4" y="6" width="16" height="16" rx="2"/></svg>',
            'education-teaching': '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/><path d="M8 7h8"/><path d="M8 11h6"/></svg>',
            'management-hr': '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>',
            'marketing-advertising': '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m22 8-6 4 6 4V8z"/><rect x="2" y="6" width="14" height="12" rx="2"/></svg>',
            'legal': '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="m3 17 4-9 4 9"/><path d="M4.5 14h5"/><path d="m13 17 4-9 4 9"/><path d="M14.5 14h5"/><path d="M12 3v18"/></svg>',
            'hospitality-food': '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><path d="M6 1v3"/><path d="M10 1v3"/><path d="M14 1v3"/></svg>'
        };
        // Color palette per slug
        const catColors = {
            'accounting-finance':    { bg: '#fef3c7', border: '#fcd34d', text: '#92400e' },
            'manual-labor':          { bg: '#e0e7ff', border: '#a5b4fc', text: '#3730a3' },
            'drivers':               { bg: '#ccfbf1', border: '#5eead4', text: '#115e59' },
            'technicians-craftsmen': { bg: '#fce7f3', border: '#f9a8d4', text: '#9d174d' },
            'security':              { bg: '#fef9c3', border: '#fde047', text: '#854d0e' },
            'sales':                 { bg: '#ffe4e6', border: '#fda4af', text: '#9f1239' },
            'customer-service':      { bg: '#f3e8ff', border: '#c4b5fd', text: '#6b21a8' },
            'it-software':           { bg: '#e0f2fe', border: '#7dd3fc', text: '#0c4a6e' },
            'engineering':           { bg: '#dcfce7', border: '#86efac', text: '#14532d' },
            'medical-pharma':        { bg: '#fee2e2', border: '#fca5a5', text: '#991b1b' },
            'education-teaching':    { bg: '#ffedd5', border: '#fdba74', text: '#9a3412' },
            'management-hr':         { bg: '#dbeafe', border: '#93c5fd', text: '#1e3a8a' },
            'marketing-advertising': { bg: '#fae8ff', border: '#e879f9', text: '#86198f' },
            'legal':                 { bg: '#f5f5f4', border: '#a8a29e', text: '#44403c' },
            'hospitality-food':      { bg: '#ecfccb', border: '#a3e635', text: '#365314' }
        };
        const defaultIcon = '<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 3h-8l-2 4h12z"/></svg>';
        const defaultColor = { bg: '#f1f5f9', border: '#cbd5e1', text: '#334155' };
        %>

        <style>
            .cat-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 1.25rem; }
            @media (max-width: 768px) {
                .cat-grid { grid-template-columns: repeat(3, 1fr); gap: 0.75rem; }
                .cat-grid a { padding: 1rem 0.5rem !important; }
                .cat-grid a h3 { font-size: 0.8rem !important; }
                .cat-grid .cat-icon-box { width: 44px !important; height: 44px !important; }
                .cat-grid .cat-icon-box svg { width: 24px !important; height: 24px !important; }
                .cat-grid .cat-count { font-size: 0.65rem !important; padding: 0.15rem 0.5rem !important; }
            }
        </style>
        <div class="cat-grid">
            <% if (locals.categories && categories.length > 0) { %>
                <% categories.forEach(cat => { %>
                    <%
                    const icon = catIcons[cat.slug] || defaultIcon;
                    const clr = catColors[cat.slug] || defaultColor;
                    const count = cat.jobs_count || 0;
                    %>
                    <a href="/jobs/category/<%= cat.slug %>" style="
                        text-decoration: none;
                        background: white;
                        border: 1px solid <%= clr.border %>40;
                        border-radius: 14px;
                        padding: 1.5rem 1rem;
                        text-align: center;
                        display: flex;
                        flex-direction: column;
                        align-items: center;
                        gap: 0.75rem;
                        transition: transform 0.2s, box-shadow 0.2s;
                    " onmouseover="this.style.transform='translateY(-4px)';this.style.boxShadow='0 8px 24px rgba(0,0,0,0.08)'" onmouseout="this.style.transform='';this.style.boxShadow=''">
                        <div class="cat-icon-box" style="
                            width: 56px;
                            height: 56px;
                            border-radius: 14px;
                            background: <%= clr.bg %>;
                            border: 1px solid <%= clr.border %>60;
                            display: flex;
                            align-items: center;
                            justify-content: center;
                            color: <%= clr.text %>;
                        "><%- icon %></div>
                        <h3 style="margin: 0; font-size: 1rem; font-weight: 700; color: #1e293b;"><%= cat.name %></h3>
                        <span class="cat-count" style="
                            font-size: 0.8rem;
                            font-weight: 600;
                            color: <%= count > 0 ? clr.text : '#94a3b8' %>;
                            background: <%= count > 0 ? clr.bg : '#f8fafc' %>;
                            padding: 0.25rem 0.75rem;
                            border-radius: 9999px;
                        "><%= count %> وظيفة متاحة</span>
                    </a>
                <% }) %>
            <% } %>
        </div>
    </div>
</section>

