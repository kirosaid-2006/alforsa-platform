<!-- Jobs Page -->
<div style="max-width: 1200px; margin: 0 auto;">

    <!-- Compact Navbar Filter with Glassmorphism -->
    <div style="background: rgba(255, 255, 255, 0.94); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); border: 1px solid rgba(255, 255, 255, 0.8); padding: 1.25rem; margin-bottom: 2rem; position: sticky; top: 75px; z-index: 40; border-radius: 18px; box-shadow: 0 10px 30px -5px rgba(14, 58, 71, 0.08);">
        <form action="/jobs" method="GET" style="display: flex; gap: 0.75rem; flex-wrap: wrap; align-items: center;">
            <input type="text" name="q" class="form-control" style="flex: 2; min-width: 200px; height: 48px; margin-bottom: 0; border-radius: 10px; background: #ffffff;" placeholder="بحث: مهندس، محاسب، فني..." value="<%= typeof query !== 'undefined' ? query.q : '' %>">
            
            <select name="cat" class="form-control" style="flex: 1; min-width: 140px; height: 48px; margin-bottom: 0; border-radius: 10px; background: #ffffff;">
                <option value="">كل التخصصات</option>
                <% if (locals.categories) { %>
                    <% categories.forEach(category => { %>
                        <option value="<%= category.id %>" <%= typeof query !== 'undefined' && query.cat == category.id ? 'selected' : '' %>><%= category.name %></option>
                    <% }) %>
                <% } %>
            </select>

            <select name="gov" class="form-control" style="flex: 1; min-width: 140px; height: 48px; margin-bottom: 0; border-radius: 10px; background: #ffffff;">
                <option value="">كل المحافظات</option>
                <% if (locals.governorates) { %>
                    <% governorates.forEach(gov => { %>
                        <option value="<%= gov.id %>" <%= typeof query !== 'undefined' && query.gov == gov.id ? 'selected' : '' %>><%= gov.name %></option>
                    <% }) %>
                <% } %>
            </select>
            
            <select name="qual" class="form-control" style="flex: 1; min-width: 130px; height: 48px; margin-bottom: 0; border-radius: 10px; background: #ffffff;">
                <option value="">المؤهل</option>
                <option value="none" <%= typeof query !== 'undefined' && query.qual === 'none' ? 'selected' : '' %>>بدون مؤهل</option>
                <option value="diploma" <%= typeof query !== 'undefined' && query.qual === 'diploma' ? 'selected' : '' %>>دبلوم / متوسط</option>
                <option value="institute" <%= typeof query !== 'undefined' && query.qual === 'institute' ? 'selected' : '' %>>فوق متوسط</option>
                <option value="bachelors" <%= typeof query !== 'undefined' && query.qual === 'bachelors' ? 'selected' : '' %>>مؤهل عالي</option>
            </select>
            
            <select name="exp" class="form-control" style="flex: 1; min-width: 120px; height: 48px; margin-bottom: 0; border-radius: 10px; background: #ffffff;">
                <option value="">الخبرة</option>
                <option value="none" <%= typeof query !== 'undefined' && query.exp === 'none' ? 'selected' : '' %>>بدون خبرة</option>
                <option value="1" <%= typeof query !== 'undefined' && query.exp === '1' ? 'selected' : '' %>>سنة+</option>
                <option value="3" <%= typeof query !== 'undefined' && query.exp === '3' ? 'selected' : '' %>>3 سنوات+</option>
                <option value="5" <%= typeof query !== 'undefined' && query.exp === '5' ? 'selected' : '' %>>5 سنوات+</option>
            </select>
            
            <div style="display: flex; gap: 0.5rem; flex: 1; min-width: 140px;">
                <button type="submit" class="btn btn-primary" style="flex: 1; height: 48px; padding: 0 1.25rem; border-radius: 10px; font-weight: 800; background: linear-gradient(135deg, #0e3a47 0%, #164e63 100%);">
                    بحث
                </button>
                <% if (typeof query !== 'undefined' && Object.keys(query).length > 0) { %>
                    <a href="/jobs" class="btn btn-outline" style="height: 48px; padding: 0 1rem; border-color: var(--danger); color: var(--danger) !important; background: var(--danger-bg); border-radius: 10px;" title="إلغاء الفلاتر">✖</a>
                <% } %>
            </div>
        </form>
    </div>

    <!-- Main Content -->
    <div class="jobs-list">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 1.75rem; flex-wrap: wrap; gap: 1rem;">
            <div>
                <h2 style="font-size: 1.6rem; font-weight: 800; color: #0e3a47; margin-bottom: 0.25rem;">
                    <%= typeof categoryName !== 'undefined' ? 'وظائف ' + categoryName : 'أحدث الوظائف المتاحة' %>
                </h2>
                <p style="color: #64748b; font-size: 0.95rem; margin: 0;">فرص عمل مباشرة ومفحوصة بواسطة مكتب التوظيف</p>
            </div>
            <span style="background: rgba(255,255,255,0.85); border: 1px solid var(--border); color: #475569; font-weight: 700; padding: 0.35rem 0.85rem; border-radius: 9999px; font-size: 0.88rem;">
                <%= locals.jobs ? jobs.length : 0 %> وظيفة متاحة
            </span>
        </div>

        <% if (locals.jobs && jobs.length > 0) { %>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(320px, 1fr)); gap: 1.5rem;">
                <% jobs.forEach(job => { %>
                    <div class="job-card" style="flex-direction: column; display: flex; height: 100%; background: rgba(255, 255, 255, 0.95); backdrop-filter: blur(8px); border: 1px solid var(--border); border-radius: 16px; padding: 1.5rem; transition: all 0.25s ease; box-shadow: 0 4px 14px rgba(14, 58, 71, 0.05);">
                        <div style="display: flex; gap: 1rem; align-items: center; margin-bottom: 1rem;">
                            <div class="job-logo" style="width: 52px; height: 52px; font-size: 1.5rem; background: #ecfeff; color: #0891b2; border: 1px solid #cff4fc; border-radius: 12px;">
                                <%= job.company_name ? job.company_name.substring(0, 1) : 'ش' %>
                            </div>
                            <div class="job-content" style="flex: 1; min-width: 0;">
                                <a href="/jobs/<%= job.slug %>" class="job-title" style="font-size: 1.15rem; font-weight: 800; color: #0e3a47; margin-bottom: 0.35rem; display: block; text-decoration: none;"><%= job.title %></a>
                                <div class="job-company" style="font-size: 0.9rem; color: #475569; display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
                                    <span>🏛️ <strong><%= job.company_name %></strong></span>
                                    <% if (job.governorate) { %>
                                        <span style="color: #64748b;">📍 <%= job.governorate.name %> <% if (job.city) { %> - <%= job.city %> <% } %></span>
                                    <% } %>
                                </div>
                            </div>
                        </div>
                        
                        <div class="job-meta" style="margin-bottom: 1.25rem; gap: 0.5rem; flex-wrap: wrap; display: flex; align-items: center;">
                            <% if (job.category) { %>
                                <span class="badge" style="background: #e0f2fe; color: #0369a1; font-weight: 700; border: 1px solid #bae6fd;">
                                    🗂️ <%= job.category.name %>
                                </span>
                            <% } %>
                            <% if (job.qualification === 'none') { %>
                                <span class="badge badge-warning">بدون مؤهل</span>
                            <% } %>
                            <span class="badge" style="background: #f8fafc; border: 1px solid #e2e8f0; color: #64748b;">
                                🕒 <%= new Date(job.published_at || job.createdAt).toLocaleDateString('ar-EG') %>
                            </span>
                        </div>
                        
                        <div class="job-actions" style="margin-top: auto; display: flex; flex-direction: column; align-items: stretch; gap: 0.75rem; border-top: 1px solid #f1f5f9; padding-top: 1rem;">
                            <div class="job-salary" style="text-align: center; color: #059669; font-weight: 800; font-size: 1.05rem;">
                                💵 <% if (job.show_salary && (job.salary_min || job.salary_max)) { %>
                                    <%= job.salary_min || 0 %> - <%= job.salary_max || 'غير محدد' %> ج.م
                                <% } else { %>
                                    الراتب يحدد بالمقابلة
                                <% } %>
                            </div>
                            <a href="/jobs/<%= job.slug %>" class="btn btn-primary" style="padding: 0.65rem; text-align: center; font-weight: 800; border-radius: 10px;">التفاصيل والتقديم</a>
                        </div>
                    </div>
                <% }) %>
            </div>
            
            <!-- Pagination stub -->
            <div style="display: flex; justify-content: center; gap: 0.5rem; margin-top: 2rem;">
                <a href="#" class="btn btn-outline">السابق</a>
                <a href="#" class="btn btn-primary">1</a>
                <a href="#" class="btn btn-outline">2</a>
                <a href="#" class="btn btn-outline">التالي</a>
            </div>
            
        <% } else { %>
            <!-- Premium Redesigned Empty State -->
            <div style="background: rgba(255, 255, 255, 0.94); backdrop-filter: blur(14px); -webkit-backdrop-filter: blur(14px); border-radius: 24px; border: 1px solid rgba(255, 255, 255, 0.9); box-shadow: 0 16px 40px -10px rgba(14, 58, 71, 0.12); padding: 4.5rem 2rem; max-width: 760px; margin: 2rem auto; text-align: center;">
                
                <!-- Animated Visual Emblem -->
                <div style="width: 100px; height: 100px; border-radius: 50%; background: linear-gradient(135deg, #f0f9ff 0%, #e0f2fe 100%); border: 2px solid #bae6fd; display: inline-flex; align-items: center; justify-content: center; color: #0284c7; margin-bottom: 2rem; box-shadow: 0 8px 24px rgba(2, 132, 199, 0.15);">
                    <svg width="46" height="46" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <rect width="20" height="14" x="2" y="7" rx="2" ry="2"/>
                        <path d="M16 21V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v16"/>
                    </svg>
                </div>
                
                <h3 style="font-size: 1.8rem; font-weight: 800; color: #0e3a47; margin-bottom: 0.85rem; letter-spacing: -0.015em;">
                    لا توجد وظائف معروضة حالياً
                </h3>
                
                <p style="color: #475569; font-size: 1.05rem; line-height: 1.8; max-width: 560px; margin: 0 auto 2.25rem;">
                    يقوم فريق مكتب التوظيف بكنيسة السيدة العذراء والشهيدة كاترين بمراجعة وتدقيق الفرص الجديدة مع المصانع والشركات للتأكد من مصداقيتها قبل نشرها.
                </p>
                
                <!-- Action Buttons -->
                <div style="display: flex; justify-content: center; gap: 1rem; flex-wrap: wrap; margin-bottom: 2.5rem;">
                    <a href="/jobs/quick-submit" class="btn" style="background: linear-gradient(135deg, #ea580c 0%, #c2410c 100%); color: white !important; font-weight: 800; padding: 0.8rem 1.85rem; border-radius: 9999px; box-shadow: 0 4px 16px rgba(234, 88, 12, 0.35); display: inline-flex; align-items: center; gap: 8px; text-decoration: none; font-size: 0.98rem;">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 5v14"/><path d="M5 12h14"/></svg>
                        أعلن عن فرصة عمل جديدة
                    </a>
                    
                    <a href="/jobs" class="btn btn-outline" style="border-radius: 9999px; padding: 0.8rem 1.6rem; font-weight: 700; border-color: #cbd5e1; color: #334155 !important; background: #ffffff;">
                        إعادة ضبط جميع الفلاتر
                    </a>
                </div>

                <!-- Job Seeker Callout Box -->
                <div style="background: #f8fafc; border: 1px dashed #cbd5e1; border-radius: 16px; padding: 1.25rem 1.5rem; text-align: right; display: flex; align-items: center; justify-content: space-between; gap: 1rem; flex-wrap: wrap;">
                    <div style="display: flex; align-items: center; gap: 12px;">
                        <div style="width: 40px; height: 40px; border-radius: 10px; background: #ecfeff; color: #0891b2; display: flex; align-items: center; justify-content: center; flex-shrink: 0;">
                            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
                        </div>
                        <div>
                            <div style="font-weight: 800; color: #0e3a47; font-size: 0.95rem;">هل تبحث عن عمل؟</div>
                            <div style="color: #64748b; font-size: 0.85rem;">سجل بياناتك ومؤهلاتك ليتواصل معك مسؤولو التوظيف فور توفر فرص تناسبك.</div>
                        </div>
                    </div>
                    
                    <a href="/auth/register" class="btn" style="background: #0e3a47; color: white !important; font-weight: 700; font-size: 0.88rem; padding: 0.5rem 1.2rem; border-radius: 8px;">
                        إنشاء حساب باحث عن عمل
                    </a>
                </div>

                <!-- Footer Assurance Note -->
                <div style="margin-top: 2rem; display: inline-flex; align-items: center; gap: 8px; color: #64748b; font-size: 0.88rem;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="#10b981" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="m9 12 2 2 4-4"/></svg>
                    خدمة مجانية بالكامل ومباشرة بدون أي رسوم تقديم أو وساطة
                </div>
            </div>
        <% } %>
    </div>
</div>
